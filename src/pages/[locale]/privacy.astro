---
/**
 * Privacy policy — /[locale]/privacy
 * Fulfills the footer link anticipated in issue #19.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CONTACT_EMAIL } from "@/lib/constants";
import { getPrivacyContent } from "@/i18n/privacy";
import type { Locale } from "@/i18n/utils";

export function getStaticPaths() {
    return [{ params: { locale: "id" } }, { params: { locale: "en" } }];
}

const { locale } = Astro.params as { locale: Locale };
const content = getPrivacyContent(locale);
---

<BaseLayout title={content.title} description={content.description}>
    <section class="px-6 pt-32 pb-20">
        <div class="mx-auto max-w-3xl">
            <nav
                aria-label={locale === "id" ? "Navigasi" : "Breadcrumb"}
                class="mb-8"
            >
                <ol
                    class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-dark/60"
                >
                    <li>
                        <a
                            href={`/${locale}/`}
                            class="font-medium hover:text-dark"
                        >
                            Kasumi Resort
                        </a>
                    </li>
                    <li aria-hidden="true" class="text-dark/35">/</li>
                    <li class="text-dark/45" aria-current="page">
                        {content.title}
                    </li>
                </ol>
            </nav>

            <h1
                class="font-heading text-4xl font-bold text-dark md:text-5xl"
            >
                {content.title}
            </h1>
            <p class="mt-3 text-sm text-dark/45">
                {content.updatedLabel}: {content.updatedDate}
            </p>
            <p class="mt-6 text-lg leading-relaxed text-dark/70">
                {content.intro}
            </p>

            <div class="mt-10 space-y-8">
                {
                    content.sections.map((section) => (
                        <div>
                            <h2 class="font-heading text-2xl font-bold text-dark">
                                {section.heading}
                            </h2>
                            {section.paragraphs.map((paragraph) => (
                                <p class="mt-3 leading-relaxed text-dark/70">
                                    {paragraph}
                                </p>
                            ))}
                        </div>
                    ))
                }
            </div>

            <p class="mt-10 border-t border-dark/10 pt-6 text-sm text-dark/55">
                {locale === "id" ? "Pertanyaan soal data Anda? " : "Questions about your data? "}
                <a
                    href={`mailto:${CONTACT_EMAIL}`}
                    class="font-medium text-primary underline"
                >
                    {CONTACT_EMAIL}
                </a>
            </p>
        </div>
    </section>
</BaseLayout>
