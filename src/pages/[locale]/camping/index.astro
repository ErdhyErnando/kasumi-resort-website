---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { campings, campingSpotsCount } from "@/lib/camping";
import { useTranslations } from "@/i18n/ui";
import type { Locale } from "@/i18n/utils";

export function getStaticPaths() {
	return [{ params: { locale: "id" } }, { params: { locale: "en" } }];
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
function formatSpotsValue(template: string, count: number): string {
	return template.replace("{count}", count.toString());
}

const localizedCampings = campings.map((camping) => ({
	id: camping.id,
	tabLabel: camping.tabLabel[locale],
	name: camping.name[locale],
	tagline: camping.tagline[locale],
	description: camping.description[locale],
	heroImage: camping.heroImage,
	gallery: camping.gallery,
	spotsLabel: formatSpotsValue(
		t.camping.index.spotsValue,
		campingSpotsCount(camping),
	),
	areas: camping.areas.map((area) => ({
		id: area.id,
		name: area.name,
		spots: area.spots,
		spotsLabel: formatSpotsValue(t.camping.index.spotsValue, area.spots.length),
		href: `/${locale}/camping/${camping.id}#${area.id}`,
	})),
	pricingNote: camping.pricingNote[locale],
	exploreHref: `/${locale}/camping/${camping.id}`,
	amenities: camping.amenities.map((item) => item[locale]),
	perfectFor: camping.perfectFor.map((item) => item[locale]),
}));
const initialCamping = localizedCampings[0];
const campingsJson = JSON.stringify(
	localizedCampings.map(({ heroImage, gallery, ...camping }) => camping),
);
---

<BaseLayout title={t.camping.index.title}>
	<section class="flex flex-col justify-center px-6 pt-46 pb-12">
		<div class="mx-auto w-full max-w-6xl" data-animate="fade-up">
			<SectionHeader
				as="h1"
				label={t.camping.index.label}
				title={t.camping.index.title}
				subtitle={t.camping.index.subtitle}
				class="mb-0"
			/>
		</div>
	</section>

	<section
		class="flex min-h-[50vh] flex-col justify-center px-6 py-12 md:min-h-[58vh] md:py-16"
	>
		<div
			class="relative left-1/2 w-screen -translate-x-1/2"
			data-animate="fade-up"
		>
			<svg
				aria-hidden="true"
				viewBox="0 0 1200 120"
				class="h-10 w-full fill-secondary"
				preserveAspectRatio="none"
			>
				<path
					d="M0,40 C250,5 350,5 600,40 C850,75 950,75 1200,40 L1200,120 L0,120 Z"
				></path>
			</svg>
			<div class="bg-secondary px-6 py-10 text-center text-highlight md:px-20">
				<p
					class="mx-auto max-w-2xl text-lg text-balance leading-relaxed md:text-3xl md:leading-relaxed"
				>
					{t.camping.index.introText}
				</p>
			</div>
			<svg
				aria-hidden="true"
				viewBox="0 0 1200 120"
				class="h-10 w-full fill-secondary"
				preserveAspectRatio="none"
			>
				<path
					d="M0,80 C250,115 350,115 600,80 C850,45 950,45 1200,80 L1200,0 L0,0 Z"
				></path>
			</svg>
		</div>
	</section>

	<section
		class="flex min-h-[70vh] flex-col justify-center px-6 pb-20 pt-12 md:min-h-[78vh] md:pb-28 md:pt-20"
	>
		<div class="mx-auto w-full max-w-6xl space-y-8" data-animate="stagger">
			<div
				class="sticky top-20 z-30 rounded-xl bg-dark px-2 py-2 shadow-lg md:rounded-full"
			>
				<div
					class="flex items-center justify-center-safe gap-2 overflow-x-auto px-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
				>
					{
						localizedCampings.map((camping, index) => (
							<button
								type="button"
								class:list={[
									"camping-tab min-w-max rounded-full px-3 py-1.5 text-xs font-medium transition-colors sm:px-4 sm:py-2 sm:text-sm",
									index === 0
										? "bg-secondary text-dark"
										: "text-highlight/85 hover:bg-white/10 hover:text-highlight",
								]}
								data-camping-tab={camping.id}
							>
								{camping.tabLabel}
							</button>
						))
					}
				</div>
			</div>

			<div class="rounded-3xl border border-dark/10 bg-white/50 p-5 md:p-8">
				<div class="grid items-start gap-7 md:grid-cols-[1.1fr_1fr]">
					<div class="space-y-5">
						<div
							id="camping-hero-visual"
							class="relative aspect-16/10 w-full overflow-hidden rounded-2xl border border-dark/5 shadow-sm"
						>
							{
								localizedCampings.map((camping, index) => (
									<div
										data-camping-hero={camping.id}
										class:list={[
											"absolute inset-0 transition-opacity duration-300",
											index === 0
												? "z-10 opacity-100"
												: "pointer-events-none z-0 opacity-0",
										]}
									>
										<Image
											src={camping.heroImage}
											alt={camping.name}
											widths={[480, 720, 1024]}
											sizes="(max-width: 768px) 100vw, 50vw"
											loading={index === 0 ? "eager" : "lazy"}
											class="h-full w-full object-cover"
										/>
									</div>
								))
							}
							<div
								class="pointer-events-none absolute inset-0 z-20 rounded-2xl bg-gradient-to-br from-[rgba(151,188,98,0.25)] to-[rgba(43,43,43,0.18)]"
								aria-hidden="true"
							>
							</div>
						</div>

						<div id="camping-amenities-dots" class="flex flex-wrap gap-2">
							{
								initialCamping.amenities.map((amenity) => (
									<span class="inline-flex max-w-full items-center gap-2 rounded-full bg-dark/10 px-3 py-1.5 text-sm text-dark/90">
										<span
											class="h-2 w-2 shrink-0 rounded-full bg-secondary"
											aria-hidden="true"
										/>
										<span>{amenity}</span>
									</span>
								))
							}
						</div>
					</div>

					<div class="space-y-5">
						<div class="flex flex-wrap items-start justify-between gap-4">
							<h3
								id="camping-name"
								class="font-heading text-3xl text-dark md:text-4xl"
							>
								{initialCamping.name}
							</h3>
							<p
								id="camping-spots"
								class="rounded-full bg-dark/10 px-3 py-1.5 text-sm font-semibold text-dark"
							>
								{initialCamping.spotsLabel}
							</p>
						</div>

						<p id="camping-tagline" class="text-base text-dark/85 md:text-lg">
							{initialCamping.tagline}
						</p>
						<p id="camping-description" class="leading-relaxed text-dark/70">
							{initialCamping.description}
						</p>
						<p
							id="camping-pricing-note"
							class="rounded-xl bg-highlight p-4 text-sm leading-relaxed font-medium text-dark"
						>
							{initialCamping.pricingNote}
						</p>
						<a
							id="camping-explore"
							href={initialCamping.exploreHref}
							class="inline-flex w-fit items-center justify-center rounded-full bg-accent px-5 py-3 text-sm font-semibold text-dark transition-opacity hover:opacity-90"
						>
							{t.camping.index.exploreLabel}
						</a>
					</div>
				</div>

				<div class="mt-10 border-t border-dark/10 pt-8">
					<div class="mb-4 flex items-center justify-between gap-4">
						<h4 class="font-heading text-2xl text-dark md:text-3xl">
							{t.camping.index.areasLabel}
						</h4>
						<div class="flex shrink-0 gap-2">
							<button
								type="button"
								id="camping-areas-prev"
								aria-label={t.camping.index.areasPrevLabel}
								class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-dark/15 text-dark transition-colors hover:bg-dark hover:text-highlight"
							>
								<svg
									aria-hidden="true"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="h-5 w-5"
								>
									<path d="m15 18-6-6 6-6"></path>
								</svg>
							</button>
							<button
								type="button"
								id="camping-areas-next"
								aria-label={t.camping.index.areasNextLabel}
								class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-dark/15 text-dark transition-colors hover:bg-dark hover:text-highlight"
							>
								<svg
									aria-hidden="true"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="h-5 w-5"
								>
									<path d="m9 18 6-6-6-6"></path>
								</svg>
							</button>
						</div>
					</div>
					<div
						id="camping-areas-track"
						data-area-link-label={t.camping.index.areaLinkLabel}
						class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
					>
						{
							initialCamping.areas.map((area) => (
								<article class="flex min-w-[85%] snap-center flex-col rounded-2xl border border-dark/10 bg-white p-5 sm:min-w-[calc(50%-0.5rem)] lg:min-w-[calc(33.333%-0.667rem)]">
									<div class="flex flex-wrap items-baseline justify-between gap-2">
										<h5 class="text-lg font-semibold text-dark">{area.name}</h5>
										<p class="text-sm font-medium text-dark/60">
											{area.spotsLabel}
										</p>
									</div>
									<ul class="mt-3 flex flex-wrap gap-1.5">
										{area.spots.map((spot) => (
											<li class="rounded-full bg-dark/10 px-2.5 py-1 text-xs text-dark/90">
												{spot}
											</li>
										))}
									</ul>
									<a
										href={area.href}
										class="mt-4 inline-flex w-fit items-center gap-1.5 text-sm font-semibold text-primary hover:underline"
									>
										{t.camping.index.areaLinkLabel}
										<svg
											aria-hidden="true"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
											class="h-4 w-4"
										>
											<path d="M5 12h14" />
											<path d="m12 5 7 7-7 7" />
										</svg>
									</a>
								</article>
							))
						}
					</div>
				</div>

				<div class="mt-10 border-t border-dark/10 pt-8">
					<div class="grid gap-4 md:grid-cols-[220px_1fr] md:gap-8">
						<h4 class="font-heading text-3xl text-dark">
							{t.camping.index.perfectFor}
						</h4>
						<ul
							id="camping-perfect-for"
							class="grid gap-3 text-dark/85 sm:grid-cols-2"
						>
							{
								initialCamping.perfectFor.map((item) => (
									<li class="text-base leading-relaxed">{item}</li>
								))
							}
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<script
		is:inline
		id="camping-data"
		type="application/json"
		data-locale={locale}
		set:html={campingsJson}
	/>
	<script>
		interface CampingAreaJson {
			id: string;
			name: string;
			spots: string[];
			spotsLabel: string;
			href: string;
		}

		interface CampingJson {
			id: string;
			tabLabel: string;
			name: string;
			tagline: string;
			description: string;
			spotsLabel: string;
			areas: CampingAreaJson[];
			pricingNote: string;
			exploreHref: string;
			amenities: string[];
			perfectFor: string[];
		}

		type CampingWindow = Window & {
			__campingTabClickBound?: boolean;
			__campingPageLoadBound?: boolean;
			__campingArrowsBound?: boolean;
		};

		const campingWindow = window as CampingWindow;

		function escapeHtml(text: string): string {
			return text
				.replace(/&/g, "&amp;")
				.replace(/</g, "&lt;")
				.replace(/>/g, "&gt;")
				.replace(/"/g, "&quot;");
		}

		function parseCampings(): CampingJson[] | null {
			const dataElement = document.getElementById("camping-data");
			const raw = dataElement?.textContent?.trim();
			if (!raw) return null;
			try {
				const parsed = JSON.parse(raw) as CampingJson[];
				return Array.isArray(parsed) && parsed.length > 0 ? parsed : null;
			} catch {
				return null;
			}
		}

		function renderCamping(id: string): void {
			const campings = parseCampings();
			if (!campings) return;

			const selected = campings.find((item) => item.id === id) ?? campings[0];
			if (!selected) return;

			const nameElement = document.getElementById("camping-name");
			const spotsElement = document.getElementById("camping-spots");
			const taglineElement = document.getElementById("camping-tagline");
			const descriptionElement = document.getElementById("camping-description");
			const pricingNoteElement = document.getElementById(
				"camping-pricing-note",
			);
			const exploreElement = document.getElementById(
				"camping-explore",
			) as HTMLAnchorElement | null;
			const areasTrack = document.getElementById("camping-areas-track");
			const amenitiesDotsElement = document.getElementById(
				"camping-amenities-dots",
			);
			const perfectForElement = document.getElementById("camping-perfect-for");
			const tabs = document.querySelectorAll("[data-camping-tab]");

			const heroImages = document.querySelectorAll("[data-camping-hero]");
			heroImages.forEach((img) => {
				const imgId = img.getAttribute("data-camping-hero");
				const isActive = imgId === selected.id;
				img.classList.toggle("z-10", isActive);
				img.classList.toggle("opacity-100", isActive);
				img.classList.toggle("z-0", !isActive);
				img.classList.toggle("opacity-0", !isActive);
				img.classList.toggle("pointer-events-none", !isActive);
			});
			if (nameElement) nameElement.textContent = selected.name;
			if (spotsElement) spotsElement.textContent = selected.spotsLabel;
			if (pricingNoteElement)
				pricingNoteElement.textContent = selected.pricingNote;
			if (exploreElement)
				exploreElement.setAttribute("href", selected.exploreHref);
			if (taglineElement) taglineElement.textContent = selected.tagline;
			if (descriptionElement)
				descriptionElement.textContent = selected.description;
			if (areasTrack) {
				const areaLinkLabel =
					areasTrack.getAttribute("data-area-link-label") ?? "";
				areasTrack.innerHTML = selected.areas
					.map(
						(area) =>
							`<article class="flex min-w-[85%] snap-center flex-col rounded-2xl border border-dark/10 bg-white p-5 sm:min-w-[calc(50%-0.5rem)] lg:min-w-[calc(33.333%-0.667rem)]"><div class="flex flex-wrap items-baseline justify-between gap-2"><h5 class="text-lg font-semibold text-dark">${escapeHtml(area.name)}</h5><p class="text-sm font-medium text-dark/60">${escapeHtml(area.spotsLabel)}</p></div><ul class="mt-3 flex flex-wrap gap-1.5">${area.spots.map((spot) => `<li class="rounded-full bg-dark/10 px-2.5 py-1 text-xs text-dark/90">${escapeHtml(spot)}</li>`).join("")}</ul><a href="${escapeHtml(area.href)}" class="mt-4 inline-flex w-fit items-center gap-1.5 text-sm font-semibold text-primary hover:underline">${escapeHtml(areaLinkLabel)}<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article>`,
					)
					.join("");
				areasTrack.scrollTo({ left: 0 });
			}
			if (amenitiesDotsElement) {
				amenitiesDotsElement.innerHTML = selected.amenities
					.map(
						(item) =>
							`<span class="inline-flex max-w-full items-center gap-2 rounded-full bg-dark/10 px-3 py-1.5 text-sm text-dark/90"><span class="h-2 w-2 shrink-0 rounded-full bg-secondary" aria-hidden="true"></span><span>${escapeHtml(item)}</span></span>`,
					)
					.join("");
			}
			if (perfectForElement) {
				perfectForElement.innerHTML = selected.perfectFor
					.map(
						(item) =>
							`<li class="text-base leading-relaxed">${escapeHtml(item)}</li>`,
					)
					.join("");
			}

			tabs.forEach((tab) => {
				const tabId = tab.getAttribute("data-camping-tab");
				const isActive = tabId === selected.id;
				tab.classList.toggle("bg-secondary", isActive);
				tab.classList.toggle("text-dark", isActive);
				tab.classList.toggle("text-highlight/85", !isActive);
				tab.classList.toggle("hover:bg-white/10", !isActive);
				tab.classList.toggle("hover:text-highlight", !isActive);
			});
		}

		function onCampingTabClick(event: MouseEvent): void {
			const rawTarget = event.target;
			const el =
				rawTarget instanceof Element
					? rawTarget
					: rawTarget instanceof Node
						? rawTarget.parentElement
						: null;
			const tab = el?.closest("[data-camping-tab]");
			if (!tab || !document.getElementById("camping-hero-visual")) return;

			const id = tab.getAttribute("data-camping-tab");
			if (!id) return;

			event.preventDefault();
			renderCamping(id);
		}

		if (!campingWindow.__campingTabClickBound) {
			campingWindow.__campingTabClickBound = true;
			document.addEventListener("click", onCampingTabClick);
		}

		function scrollAreasTrack(direction: 1 | -1): void {
			const track = document.getElementById("camping-areas-track");
			if (!track) return;
			const firstCard = track.querySelector("article");
			const step = (firstCard as HTMLElement | null)?.offsetWidth
				? (firstCard as HTMLElement).offsetWidth + 16
				: track.clientWidth * 0.8;
			track.scrollBy({ left: direction * step, behavior: "smooth" });
		}

		if (!campingWindow.__campingArrowsBound) {
			campingWindow.__campingArrowsBound = true;
			document.addEventListener("click", (event: MouseEvent) => {
				const rawTarget = event.target;
				const el =
					rawTarget instanceof Element
						? rawTarget
						: rawTarget instanceof Node
							? rawTarget.parentElement
							: null;
				const button = el?.closest("#camping-areas-prev, #camping-areas-next");
				if (!button || !document.getElementById("camping-areas-track")) return;
				event.preventDefault();
				scrollAreasTrack(button.id === "camping-areas-next" ? 1 : -1);
			});
		}

		if (!campingWindow.__campingPageLoadBound) {
			campingWindow.__campingPageLoadBound = true;
			document.addEventListener("astro:page-load", () => {
				if (!document.getElementById("camping-hero-visual")) return;
				const campings = parseCampings();
				if (!campings) return;
				renderCamping(campings[0].id);
			});
		}
	</script>
</BaseLayout>
